# 平台默认模型（推荐直接维护这里）
VITE_PLATFORM_DEFAULT_PRESET_NAME=平台默认模型
VITE_PLATFORM_DEFAULT_VENDOR=gemini
VITE_PLATFORM_DEFAULT_TRANSPORT=gemini_native
VITE_PLATFORM_DEFAULT_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VITE_PLATFORM_DEFAULT_MODEL=gemini-2.5-pro
VITE_PLATFORM_DEFAULT_API_KEY=your_api_key_here
# 可选：高级请求参数，必须是 JSON 对象。不同厂商字段会原样合并到请求体。
# VITE_PLATFORM_DEFAULT_REQUEST_OPTIONS={"generationConfig":{"thinkingConfig":{"thinkingBudget":2048}}}

# 兼容旧配置：如果只保留这个 key，系统仍会按 Gemini 默认连接启动
# VITE_GEMINI_API_KEY=your_gemini_api_key_here

# 可选：额外生成只读预设，供页面里切换使用
# VITE_DEFAULT_GEMINI_API_KEY=
# VITE_DEFAULT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# VITE_DEFAULT_GEMINI_MODEL=gemini-2.5-pro
# VITE_DEFAULT_GEMINI_REQUEST_OPTIONS=
# VITE_DEFAULT_ANTHROPIC_API_KEY=
# VITE_DEFAULT_ANTHROPIC_BASE_URL=https://api.anthropic.com
# VITE_DEFAULT_ANTHROPIC_MODEL=claude-sonnet-4-6
# VITE_DEFAULT_ANTHROPIC_REQUEST_OPTIONS=
# VITE_DEFAULT_OPENAI_API_KEY=
# VITE_DEFAULT_OPENAI_BASE_URL=https://api.openai.com/v1
# VITE_DEFAULT_OPENAI_MODEL=gpt-4.1
# VITE_DEFAULT_OPENAI_REQUEST_OPTIONS=
# VITE_DEFAULT_ONEAPI_API_KEY=
# VITE_DEFAULT_ONEAPI_BASE_URL=
# VITE_DEFAULT_ONEAPI_MODEL=
# VITE_DEFAULT_ONEAPI_REQUEST_OPTIONS=
# VITE_DEFAULT_DEEPSEEK_API_KEY=
# VITE_DEFAULT_DEEPSEEK_BASE_URL=https://api.deepseek.com
# VITE_DEFAULT_DEEPSEEK_MODEL=deepseek-v4-pro
# VITE_DEFAULT_DEEPSEEK_REQUEST_OPTIONS={"max_tokens":8192}
# DeepSeek/GLM 思考模式示例：{"thinking":{"type":"enabled"},"max_tokens":8192}
# VITE_DEFAULT_GLM_API_KEY=
# VITE_DEFAULT_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# VITE_DEFAULT_GLM_MODEL=glm-4.7
# VITE_DEFAULT_GLM_REQUEST_OPTIONS=
