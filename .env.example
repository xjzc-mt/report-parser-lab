# ── 前端非敏感默认值 ─────────────────────────────────────────────
# 这里只放厂商、地址、模型名等非敏感信息；不要放公司 API Key。
VITE_PLATFORM_DEFAULT_PRESET_NAME=OpenAI 兼容
VITE_PLATFORM_DEFAULT_VENDOR=openai
VITE_PLATFORM_DEFAULT_TRANSPORT=openai_compatible
VITE_PLATFORM_DEFAULT_BASE_URL=https://api.openai.com/v1
VITE_PLATFORM_DEFAULT_MODEL=
# VITE_PLATFORM_DEFAULT_REQUEST_OPTIONS={"generationConfig":{"thinkingConfig":{"thinkingBudget":2048}}}

# ── 服务端配置 ───────────────────────────────────────────────────
# npm run dev:server / npm run server 会读取本文件；Vite 只读取 VITE_* 给前端。
PORT=8787
HOST=127.0.0.1

# 管理员账号：至少配置 ADMIN_PASSWORD 或 ADMIN_PASSWORD_HASH 之一。
# 生产建议使用 `npm run hash-password -- '密码'` 生成哈希后填写 ADMIN_PASSWORD_HASH。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=

# 服务端配置文件路径；文件包含公司 Key，必须放在持久化卷并限制访问权限。
LLM_LAB_CONFIG_PATH=server/data/config.json

# 首次启动时用以下配置初始化一条公司连接；已有连接时不会覆盖。
# COMPANY_DEFAULT_API_KEY 不会进入前端构建产物。
COMPANY_DEFAULT_API_KEY=
COMPANY_DEFAULT_NAME=团队模型
COMPANY_DEFAULT_VENDOR=openai
COMPANY_DEFAULT_TRANSPORT=openai_compatible
COMPANY_DEFAULT_BASE_URL=https://api.openai.com/v1
# 留空表示首次启动只创建连接，模型由管理员在后台 Ping 后勾选开放。
COMPANY_DEFAULT_MODEL=
AUTO_SEED_COMPANY=true

# HTTPS 部署时设为 true；本地 HTTP 调试保持 false。
COOKIE_SECURE=false
# 仅在反向代理已经正确覆盖 X-Forwarded-* 时开启。
TRUST_PROXY=false
# 如需限制管理接口来源，填写逗号分隔的完整 Origin。
ALLOWED_ORIGINS=

# 公司模型转发限制。
UPSTREAM_TIMEOUT_MS=300000
MAX_PROXY_BODY_BYTES=52428800
PROXY_RATE_LIMIT_PER_MINUTE=600
LOG_UPSTREAM_ERRORS=false
